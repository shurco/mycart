{
  "name": "mycart-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bunx vite dev",
    "build": "bun --bunx vite build",
    "preview": "bun --bunx vite preview",
    "check": "bun --bunx svelte-kit sync && bun --bunx svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "update": "bun update",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:browser": "vitest --config vitest.browser.config.ts",
    "test:browser:ui": "vitest --config vitest.browser.config.ts --ui"
  },
  "dependencies": {
    "@portone/browser-sdk": "^0.1.14",
    "isomorphic-dompurify": "^3.23.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-webdriverio": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "^10.7.0",
    "happy-dom": "^20.14.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "webdriverio": "^9.33.1"
  }
}
